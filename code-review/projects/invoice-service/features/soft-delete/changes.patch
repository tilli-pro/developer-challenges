+
+  it("soft-deletes a draft invoice", async () => {
+    const created = await createInvoice(app);
+
+    const response = await app.inject({
+      method: "DELETE",
+      url: `/invoices/${created.id}`,
+      headers: ADMIN,
+    });
+    assert.equal(response.statusCode, 200);
+    assert.equal(response.json<Invoice>().isDeleted, true);
+    assert.equal(response.json<Invoice>().id, created.id);
+  });
+
+  it("hides deleted invoices from the list unless asked", async () => {
+    const kept = await createInvoice(app);
+    const deleted = await createInvoice(app);
+    await app.inject({
+      method: "DELETE",
+      url: `/invoices/${deleted.id}`,
+      headers: ADMIN,
+    });
+
+    const list = await app.inject({
+      method: "GET",
+      url: "/invoices",
+      headers: ADMIN,
+    });
+    const ids = list.json<InvoicePage>().items.map((invoice) => invoice.id);
+    assert.deepEqual(ids, [kept.id]);
+
+    const all = await app.inject({
+      method: "GET",
+      url: "/invoices?includeDeleted=true",
+      headers: ADMIN,
+    });
+    assert.equal(all.json<InvoicePage>().items.length, 2);
+  });
