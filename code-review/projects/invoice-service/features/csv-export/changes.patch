+/** Same filters as GET /invoices, without paging. */
+type ExportInvoicesRoute = {
+  Querystring: Pick<ListInvoicesQuery, "customerId" | "status">;
+};
+
+/**
+ * GET /invoices/export.csv: one row per invoice matching the filters. Kept
+ * out of `invoiceRoutes` because app.ts registers it next to /health, where
+ * the finance dashboard's scheduled pull picks it up.
+ */
+export function exportRoutes(
+  app: FastifyInstance,
+  service: InvoiceService,
+): void {
+  app.get<ExportInvoicesRoute>(
+    "/invoices/export.csv",
+    async (request, reply) => {
+      reply.hijack();
+      // Send the headers straight away so the download starts while we query.
+      reply.raw.writeHead(200, { "content-type": "text/plain; charset=utf-8" });
+      try {
+        const rows = toCsvRows(service.listForExport(request.query));
+        reply.raw.write(rows.join("\n"));
+      } finally {
+        reply.raw.end();
+      }
+    },
+  );
+}
