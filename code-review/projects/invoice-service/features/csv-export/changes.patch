diff --git a/src/lib/csv.ts b/src/lib/csv.ts
new file mode 100644
index 0000000..51f2d81
--- /dev/null
+++ b/src/lib/csv.ts
@@ -0,0 +1,37 @@
+import type { Invoice } from "../schemas";
+
+/** Columns of the invoice export, in order. */
+export const CSV_COLUMNS = [
+  "number",
+  "customerId",
+  "status",
+  "currency",
+  "issuedAt",
+  "dueAt",
+  "totalCents",
+  "lineCount",
+] as const;
+
+/** One invoice as a CSV line, in `CSV_COLUMNS` order. */
+export function formatRow(invoice: Invoice): string {
+  const fields = [
+    invoice.number,
+    invoice.customerId,
+    invoice.status,
+    invoice.currency,
+    invoice.issuedAt ? new Date(invoice.issuedAt).toLocaleDateString() : "",
+    invoice.dueAt ?? "",
+    String(invoice.totalCents),
+    String(invoice.lines.length),
+  ];
+  return fields.join(",");
+}
+
+/**
+ * The header line followed by one line per invoice. No I/O here, so the route
+ * decides how the lines are written out.
+ */
+export function toCsvRows(invoices: readonly Invoice[]): string[] {
+  if (invoices.length === 0) return [];
+  return [CSV_COLUMNS.join(","), ...invoices.map(formatRow)];
+}
