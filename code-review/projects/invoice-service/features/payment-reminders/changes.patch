+  /** Emails every overdue invoice that has not had a reminder yet. */
+  async sendReminders(): Promise<ReminderRun> {
+    const now = this.now();
+    const overdue = this.repo.findOverdueUnreminded(now.slice(0, 10));
+    const run: ReminderRun = { scanned: overdue.length, sent: 0, failed: 0 };
+
+    for (const record of overdue) {
+      const invoice = withTotals(record);
+      const to = await this.directory.lookup(invoice.customerId);
+      if (!to) {
+        // No billing contact on file; leave it for the next run.
+        run.failed++;
+        continue;
+      }
+
+      try {
+        await this.mailer.send({
+          to,
+          subject: `Invoice ${invoice.number} is overdue`,
+          text: reminderText(invoice),
+        });
+        run.sent++;
+      } catch {
+        run.failed++;
+      }
+      this.repo.markReminded(invoice.id, now);
+    }
+    return run;
+  }
+
   private now(): string {
     return this.clock().toISOString();
