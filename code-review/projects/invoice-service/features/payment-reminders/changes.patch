+
+function reminderText(invoice: Invoice): string {
+  const amount = (invoice.totalCents / 100).toFixed(2);
+  const due = invoice.dueAt?.slice(0, 10);
+  return [
+    `Invoice ${invoice.number} for ${amount} ${invoice.currency} was due on ${due}`,
+    "and is now more than 3 days overdue. If you have already paid, please",
+    "ignore this email.",
+  ].join("\n");
+}
