+export type Email = { to: string; subject: string; text: string };
+
+export interface Mailer {
+  send(email: Email): Promise<void>;
+}
+
+/** In-process stand-in for the email provider; keeps what it was sent. */
+export class FakeMailer implements Mailer {
+  readonly sent: Email[] = [];
+
+  async send(email: Email): Promise<void> {
+    this.sent.push(email);
+  }
+}
+
+/** Billing contacts, kept in the CRM. */
+export interface CustomerDirectory {
+  lookup(customerId: string): Promise<string | null>;
+  lookupMany(customerIds: string[]): Promise<Map<string, string>>;
+}
+
+/** In-process stand-in for the CRM. Unknown customers get a placeholder. */
+export class FakeCustomerDirectory implements CustomerDirectory {
+  constructor(
+    private readonly emails = new Map([["cus_acme", "billing@acme.example"]]),
+  ) {}
+
+  async lookup(customerId: string): Promise<string | null> {
+    return this.emails.get(customerId) ?? `${customerId}@example.com`;
+  }
+
+  async lookupMany(customerIds: string[]): Promise<Map<string, string>> {
+    const found = new Map<string, string>();
+    for (const id of customerIds) {
+      found.set(id, this.emails.get(id) ?? `${id}@example.com`);
+    }
+    return found;
+  }
+}
