+/**
+ * Re-runs a stored event, for example one that failed because its payment had
+ * not arrived yet. Acme's retries of a failed event are acknowledged as
+ * duplicates, so without this a failed event stays failed.
+ */
+export function replayRoutes(
+  app: FastifyInstance,
+  deps: { events: EventService },
+): void {
+  app.post<ByIdRoute>(
+    "/events/:id/replay",
+    { schema: replayEventSchema },
+    async (request) => {
+      const { id } = request.params;
+      try {
+        deps.events.replay(id);
+      } catch (err) {
+        // processEvent has recorded the error and the replay itself ran, so
+        // don't leave the event sitting in the failed list.
+        request.log.warn({ err, eventId: id }, "replayed event threw");
+        deps.events.finishReplay(id);
+      }
+      return { ok: true };
+    },
+  );
+}
