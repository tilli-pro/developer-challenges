+  /**
+   * Runs a stored event through `processEvent` again, for an event that failed
+   * (say a refund that arrived before its payment) or one an operator wants
+   * re-applied. Records when it was replayed and how many times.
+   */
+  replay(eventId: string): void {
+    const row = this.db
+      .prepare("SELECT replay_count FROM events WHERE id = ?")
+      .get(eventId);
+    // Unknown id: nothing stored, so nothing to replay.
+    if (!row) return;
+
+    const replayCount = Number(row.replay_count) + 1;
+    // processEvent only picks up events in `received`, so put it back there.
+    this.db
+      .prepare(
+        `UPDATE events
+         SET status = 'received', error = NULL,
+           replayed_at = ?, replay_count = ?
+         WHERE id = ?`,
+      )
+      .run(Date.now(), replayCount, eventId);
+
+    this.processEvent(eventId);
+  }
+
+  /** Closes out a replay so the event no longer shows up as failed. */
+  finishReplay(eventId: string): void {
+    this.db
+      .prepare(
+        `UPDATE events SET status = 'processed', error = NULL, processed_at = ?
+         WHERE id = ?`,
+      )
+      .run(this.now(), eventId);
+  }
