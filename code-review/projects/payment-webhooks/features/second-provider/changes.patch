+  /** Bolt's charge events, applied the same way as Acme's. */
+  private applyBolt(eventId: string, charge: BoltCharge, now: string) {
+    const paymentId = charge.charge_id;
+    const upsert = {
+      id: randomUUID(),
+      provider: "bolt",
+      paymentId,
+      amountCents: Number(charge.amount) * 100,
+      currency: charge.currency,
+      now,
+    };
+
