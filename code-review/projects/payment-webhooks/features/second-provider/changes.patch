-/** Everything the webhook route needs to authenticate one provider. */
+/** HMAC-SHA256 of the raw body, base64 encoded, as Bolt sends it. */
+export function signBolt(rawBody: string, secret: string): string {
+  return createHmac("sha256", secret).update(rawBody).digest("base64");
+}
+
+/** Checks `x-bolt-signature`. Bolt signs no timestamp, so there is no window. */
+export function verifyBoltSignature(
+  header: string,
+  rawBody: string,
+  secret: string,
+): boolean {
+  return signBolt(rawBody, secret) === header.trim();
+}
+
+const BOLT_TYPES: Record<BoltCharge["event_type"], EventType> = {
+  "charge.succeeded": "payment.succeeded",
+  "charge.failed": "payment.failed",
+  "charge.refunded": "refund.created",
+};
+const BOLT_AMOUNT = /^\d+\.\d{2}$/;
+
+/** Maps a Bolt event onto ours; `created` is when we received it. */
+export function normalizeBolt(body: unknown, now: Date): unknown {
+  const charge = (body ?? {}) as Partial<BoltCharge>;
+  const type = BOLT_TYPES[charge.event_type as BoltCharge["event_type"]];
+  if (!type) throw badRequest("event_type is not a Bolt charge event");
+  if (typeof charge.amount !== "string" || !BOLT_AMOUNT.test(charge.amount)) {
+    throw badRequest("amount must be a decimal string such as 12.34");
+  }
+
+  const created = Math.floor(now.getTime() / 1000);
+  const data = {
+    paymentId: charge.charge_id,
+    amountCents: Math.round(parseFloat(charge.amount) * 100),
+    currency: charge.currency,
+  };
+  if (charge.event_type === "charge.refunded") {
+    // A refund is matched to its payment by the charge id, not by event.
+    return { type, created, data };
+  }
+  return { id: charge.event_id, type, created, data };
+}
+
