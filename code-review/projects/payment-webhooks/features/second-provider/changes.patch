+          .get(paymentId);
+        if (!payment || payment.status === "failed") {
+          throw new Error(`no refundable payment ${paymentId}`);
+        }
+        if (payment.currency !== upsert.currency) {
+          throw new Error(
+            `refund in ${upsert.currency}, paid in ${payment.currency}`,
+          );
+        }
+        const refunded = Number(payment.refunded_cents) + upsert.amountCents;
+        const status: PaymentStatus =
