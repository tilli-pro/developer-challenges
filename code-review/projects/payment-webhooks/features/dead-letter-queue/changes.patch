+             (id, topic, payload, attempts, next_attempt_at, created_at)
+           SELECT outbox_id, topic, payload, attempts, ?, ?
+           FROM dead_letters WHERE id = ?`,
+        )
+        .run(now, now, id);
+      this.db.prepare("DELETE FROM dead_letters WHERE id = ?").run(id);
+    });
+    return { outboxId: row.outbox_id as string };
+  }
