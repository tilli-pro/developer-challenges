+
+describe("GET /admin/events", () => {
+  let ctx: TestContext;
+
+  beforeEach(() => {
+    ctx = testApp();
+  });
+
+  afterEach(async () => {
+    await ctx.app.close();
+  });
+
+  const listEvents = (query: string) =>
+    ctx.app.inject({
+      method: "GET",
+      url: `/admin/events?${query}`,
+      headers: ADMIN,
+    });
+
+  it("filters by type and provider", async () => {
+    await postWebhook(ctx.app, acmeEvent());
+    await postWebhook(
+      ctx.app,
+      acmeEvent({
+        id: "evt_002",
+        type: "refund.created",
+        data: { paymentId: "pay_001", amountCents: 2_500, currency: "USD" },
+      }),
+    );
+
+    const response = await listEvents("type=refund.created&provider=acme");
+    assert.equal(response.statusCode, 200);
+    const { items, nextCursor } = response.json();
+    assert.deepEqual(
+      items.map((event: { externalId: string }) => event.externalId),
+      ["evt_002"],
+    );
+    assert.equal(nextCursor, null);
+  });
+
+  it("pages through every event with the cursor", async () => {
+    const ids = ["evt_001", "evt_002", "evt_003", "evt_004", "evt_005"];
+    for (const [index, id] of ids.entries()) {
+      await postWebhook(
+        ctx.app,
+        acmeEvent({
+          id,
+          data: {
+            paymentId: `pay_00${index + 1}`,
+            amountCents: 1_000,
+            currency: "USD",
+          },
+        }),
+      );
+    }
+
+    const seen: string[] = [];
+    let cursor: string | null = null;
+    let pages = 0;
+    do {
+      const response = await listEvents(
+        cursor ? `limit=2&cursor=${cursor}` : "limit=2",
+      );
+      assert.equal(response.statusCode, 200);
+      const page = response.json();
+      seen.push(
+        ...page.items.map((event: { externalId: string }) => event.externalId),
+      );
+      cursor = page.nextCursor;
+      pages++;
+    } while (cursor);
+
+    assert.equal(pages, 3);
+    assert.deepEqual(seen, ids);
+  });
+
+  it("rejects an unknown provider and a malformed cursor", async () => {
+    const provider = await listEvents("provider=stripe");
+    assert.equal(provider.statusCode, 400);
+    assert.equal(provider.json().error.code, "validation_failed");
+
+    const cursor = await listEvents("cursor=bm90LWEtbnVtYmVy");
+    assert.equal(cursor.statusCode, 400);
+    assert.equal(cursor.json().error.code, "bad_request");
+  });
+});
